# Copy to deploy/.env on the VPS and fill in your real domain.
# docker compose reads this file automatically.

# Front-end subdomain (where users open the app).
APP_DOMAIN=app.seu-dominio.com

# Back-end subdomain (where the browser calls the API).
API_DOMAIN=api.seu-dominio.com

# If the backend needs a database password, uncomment and set it.
# DB_PASSWORD=troque-por-uma-senha-forte
