{"openapi":"3.1.0","info":{"title":"WorkLog API","description":"API para gerenciamento de tickets e interações de suporte ao cliente. Autenticação via cookie HttpOnly `worklog_access` emitido pelo endpoint `POST /worklog/auth/login` (o browser anexa o cookie automaticamente em chamadas subsequentes).","contact":{"name":"Luiz Brand"},"version":"v1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"cookieAuth":[]}],"tags":[{"name":"Sistemas","description":"Gerenciamento dos sistemas/produtos atendidos pelo suporte"},{"name":"Autenticação","description":"Endpoints de registro, login, refresh token e logout (tokens via cookies HttpOnly)"},{"name":"Usuários","description":"Consulta e gerenciamento de usuários do sistema"},{"name":"Tickets","description":"Gerenciamento de tickets de suporte — criação, consulta e atualização com log de alterações"},{"name":"Clientes","description":"Gerenciamento de clientes e seus sistemas associados"}],"paths":{"/tickets/update/{ticketPublicId}":{"put":{"tags":["Tickets"],"summary":"Atualizar ticket","description":"Atualiza um ticket existente. Apenas os campos enviados serão alterados. Todas as mudanças são registradas automaticamente no log de auditoria (TicketLog).","operationId":"updateTicket","parameters":[{"name":"ticketPublicId","in":"path","description":"ID público do ticket (UUID)","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TicketUpdateRequest"}}},"required":true},"responses":{"200":{"description":"Ticket atualizado com sucesso","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TicketResponse"}}}},"404":{"description":"Ticket não encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiExceptionResponse"}}}},"400":{"description":"Dados de entrada inválidos","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiExceptionResponse"}}}},"401":{"description